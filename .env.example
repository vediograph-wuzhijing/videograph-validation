# Copy to .env.local (ignored by Git). Default local instance:
VITE_VIDEOGRAPH_SERVICE_URL=http://127.0.0.1:5191
VIDEOGRAPH_SERVICE_URL=http://127.0.0.1:5191
VIDEOGRAPH_SERVICE_PORT=5191
VIDEOGRAPH_STUDIO_ORIGINS=http://127.0.0.1:5188,http://localhost:5188
VIDEOGRAPH_JOB_STALL_MS=600000

# A second independent clone on the same machine can use backend 5291
# and `npm run dev -- --port 5288 --strictPort`; change all URLs above together.
# Keep projects and tokens inside that clone, or set separate absolute paths:
# VIDEOGRAPH_PROJECTS=F:/your-independent-workspace/projects
# VIDEOGRAPH_SERVICE_TOKEN_FILE=F:/your-independent-workspace/.cache/service-token
