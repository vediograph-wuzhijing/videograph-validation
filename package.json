{
  "name": "video-graph-demo",
  "private": true,
  "version": "0.2.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "service": "node --env-file-if-exists=.env.local src/server/index.mjs",
    "project:backup": "node --env-file-if-exists=.env.local scripts/project-backup.mjs",
    "audit:reference": "node scripts/reference-engine-audit.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "audit": "node scripts/audit-all.mjs",
    "mcp": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings src/pdoom/mcp-server.ts",
    "mcp:pdoom": "npm run mcp",
    "test": "node scripts/test.mjs",
    "test:portable": "node scripts/test.mjs --portable",
    "typecheck": "node scripts/check.mjs --types-only",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --full",
    "audit:feedback": "node scripts/tests/collaboration/feedback-e2e.audit.mjs",
    "workbench": "node --env-file-if-exists=.env.local scripts/workbench.mjs",
    "project:maintenance": "node --env-file-if-exists=.env.local scripts/project-maintenance.mjs",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/three": "^0.186.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "opentype.js": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sucrase": "^3.35.1",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
